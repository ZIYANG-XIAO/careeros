POSTGRES_USER=careeros
POSTGRES_PASSWORD=careeros_dev
POSTGRES_DB=careeros
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://careeros:careeros_dev@localhost:5432/careeros
WEB_ORIGIN=http://localhost:3000
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev
OPENAI_API_KEY=
OPENAI_RESUME_PARSER_MODEL=gpt-5-mini
OPENAI_JOB_PARSER_MODEL=gpt-5-mini
OPENAI_JOB_MATCHER_MODEL=gpt-5-mini
OPENAI_ANSWER_CLASSIFIER_MODEL=gpt-5-mini
RESUME_STORAGE_DIR=.local/resume-assets
MAX_RESUME_SIZE_BYTES=10485760

# Optional: only set this to a separate, explicitly disposable PostgreSQL
# database when running destructive migration tests. Never reuse DATABASE_URL.
# TEST_DATABASE_URL=postgresql+asyncpg://careeros:careeros_dev@localhost:5432/careeros_test
