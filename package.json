{
  "name": "careeros",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/extension"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "web:dev": "npm --workspace @careeros/web run dev",
    "web:build": "npm --workspace @careeros/web run build",
    "web:lint": "npm --workspace @careeros/web run lint",
    "web:typecheck": "npm --workspace @careeros/web run typecheck",
    "web:test": "npm --workspace @careeros/web run test",
    "web:format": "npm --workspace @careeros/web run format",
    "extension:build": "npm --workspace @careeros/extension run build",
    "extension:dev": "npm --workspace @careeros/extension run dev",
    "extension:typecheck": "npm --workspace @careeros/extension run typecheck",
    "extension:test": "npm --workspace @careeros/extension run test",
    "extension:format": "npm --workspace @careeros/extension run format",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
